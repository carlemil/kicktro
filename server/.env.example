# Copy to /srv/kicktro/.env on the server (chmod 600). Never commit the real file.
# server/compose.yml reads it; the Dockerfile sets PORT, DB_PATH and THUMB_DIR.

# The OAuth client id the page's Google sign-in uses (CONFIG.cloud.clientId in src/config.js).
GOOGLE_CLIENT_ID=180474887753-jf22fn1kgkecamc2inr2eoomh0e1e0j4.apps.googleusercontent.com

# Sign in with Apple: the Services ID (CONFIG.cloud.appleClientId). compose.yml already sets
# it for the live server; empty = POST /api/auth/apple answers 404.
# APPLE_CLIENT_ID=com.kicktro.signin

# Signs session tokens. 32+ characters. Make one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Changing it signs everybody out.
SESSION_SECRET=

# Bearer token for /api/admin/* (thumbnail upload, the one-time Firebase import). 24+
# characters, made the same way. Empty = the admin routes answer 404.
ADMIN_TOKEN=

# Origins allowed by CORS, comma-separated.
ALLOWED_ORIGINS=https://kicktro.com,https://carlemil.github.io

# Days a session lasts before the page has to sign in again.
SESSION_DAYS=60
