rules_version = '2';

// Kicktro — cloud profiles, FROZEN (card 825, M2).
//
// Cloud profiles moved to the Kicktro API (api.kicktro.com, server/ in this repo). Everything
// here was exported by tools/firebase-export.js and imported there; these rules stop the data
// changing underneath that copy. NOTHING is writable — no create, update or delete anywhere.
//
// Reads stay exactly as they were, because two things still read:
//   - the production page until the release that switches it to the API ships (it lists the
//     gallery with `where pub == true` and loads the signed-in user's own profile);
//   - cloudFetchScene's fallback, which tries a #c= link the API does not know against its old
//     public /scenes document (CONFIG.cloud.apiKey/projectId).
//
// Deploy: paste into Firebase console → Firestore → Rules → Publish. When the Firebase project
// is deleted, this file, firebase.json, firestore.indexes.json and the two config keys go with it.
// The pre-freeze rules (size caps, field shapes, the nineteen Playground cases) are in git:
// `git show 03ee03b:firestore.rules`.

service cloud.firestore {
  match /databases/{database}/documents {

    // Readable by the owner always, and by anyone once published. The gallery query must
    // filter `where pub == true` — rules are evaluated against the QUERY, not the results.
    match /profiles/{uid} {
      allow read: if resource.data.pub == true || request.auth.uid == uid;
      allow write: if false;
    }

    // A share link opens by id for anyone (`get`), but the collection is not enumerable
    // (`list` would turn links meant for one person into a public directory).
    match /scenes/{id} {
      allow get: if true;
      allow list: if false;
      allow write: if false;
    }

    // Everything else, the retired /profiles/{uid}/snapshots included, is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
